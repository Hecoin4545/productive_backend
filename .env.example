# Backend
PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/dbname
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173
# The deployed frontend URL — used to allow CORS requests
